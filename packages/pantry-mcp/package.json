{
  "name": "@peckish/pantry-mcp",
  "version": "0.1.0",
  "description": "MCP server that owns persistent pantry state for Peckish.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pantry-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.0"
  }
}
