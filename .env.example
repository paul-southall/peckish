# Anthropic API key — required for skill and PantryMCP runtime calls.
# Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# GitHub token — required for the GitHub MCP if running locally.
# Use a fine-grained token scoped to this repository.
GITHUB_TOKEN=

# Override the SQLite database path used by PantryMCP.
# Default: ~/.peckish/pantry.sqlite (auto-created on first run).
# PECKISH_DB_PATH=

# Set the monthly cost cap in the Anthropic console, not via env var.
